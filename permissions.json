      "wc",
      "wc *",
      "tr",
      "tr *",
      "printf",
      "printf *",
      "head",
      "head *",
      "tail",
      "tail *"
    ],
    "NETWORK": [
      "gh pr view *",
      "gh api *"
    ]
  },
  "paths": {
