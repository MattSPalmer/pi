{
  "bash": {
    "DENY": [
      "gh api * --method *",
      "gh api * --method=*",
      "gh api --method * *",
      "gh api --method=* *",
      "gh api * -X *",
      "gh api * -X*",
      "gh api -X * *",
      "gh api -X* *",
      "gh api * --field *",
      "gh api * --field=*",
      "gh api * --raw-field *",
      "gh api * --raw-field=*",
      "gh api * --input *",
      "gh api * --input=*",
      "gh api * -F *",
      "gh api * -F=*",
      "gh api * -F*",
      "gh api * -f *",
      "gh api * -f=*",
      "gh api * -f*",
      "gh api * -i *",
      "gh api * -i*"
    ],
    "READ": [
      "pwd",
      "rg",
      "rg *",
      "ls",
      "ls *",
      "sort",
      "sort *",
      "uniq",
