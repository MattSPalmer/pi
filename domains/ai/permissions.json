      "workspace add",
      "workspace forget",
      "workspace rename",
      "workspace update-stale",
      "desc",
      "e",
      "n",
      {
        "externalShell": "je"
      },
      {
        "externalShell": "jn"
      },
      {
        "externalShell": "jne"
      },
      {
        "externalShell": "jsq"
      },
      {
        "externalShell": "jb"
      },
      {
        "externalShell": "jr"
      },
      {
        "externalShell": "jdc"
      },
      {
        "externalShell": "jddc"
      },
      {
        "externalShell": "jep"
