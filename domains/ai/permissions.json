    "NETWORK": [
      "git clone",
      "git export",
      "git import",
      "git init",
      "git push",
      "git remote",
      "sign",
      "unsign",
      {
        "externalShell": "jgp"
      }
    ],
    "ADMIN": [
      "config"
    ]
  }
}
