{
  "bash": {
    "pwd": "allow",
    "git": {
      "action": "deny",
      "context": "git use is precluded entirely by jj (`jj --help` if you're unfamiliar)."
    },
    "git *": {
      "action": "deny",
      "context": "git use is precluded entirely by jj (`jj --help` if you're unfamiliar)."
    },
    "find": {
      "action": "deny",
      "context": "find use is precluded entirely by fd (`fd --help` if you're unfamiliar)."
    },
    "find *": {
      "action": "deny",
      "context": "find use is precluded entirely by fd (`fd --help` if you're unfamiliar)."
    },
    "*/git": {
      "action": "deny",
      "context": "git use is precluded entirely by jj (`jj --help` if you're unfamiliar)."
    },
    "*/git *": {
      "action": "deny",
      "context": "git use is precluded entirely by jj (`jj --help` if you're unfamiliar)."
    },
    "rg": "allow",
    "rg *": "allow",
    "grep": {
      "action": "deny",
      "context": "grep use is precluded entirely by rg (`rg --help` if you're unfamiliar)."
    },
    "grep *": {
      "action": "deny",
      "context": "grep use is precluded entirely by rg (`rg --help` if you're unfamiliar)."
    },
    "ls": "allow",
    "ls *": "allow",
    "sort": "allow",
    "sort *": "allow",
    "uniq": "allow",
    "uniq *": "allow",
    "wc": "allow",
    "wc *": "allow",
    "tr": "allow",
    "tr *": "allow",
    "printf": "allow",
    "printf *": "allow",
    "head": "allow",
    "head *": "allow",
    "tail": "allow",
    "tail *": "allow",
    "gh pr view *": "allow",
    "gh api *": "allow",
    "gh api * --method *": "deny",
    "gh api * --method=*": "deny",
    "gh api --method * *": "deny",
    "gh api --method=* *": "deny",
    "gh api * -X *": "deny",
    "gh api * -X*": "deny",
    "gh api -X * *": "deny",
    "gh api -X* *": "deny",
    "gh api * --field *": "deny",
    "gh api * --field=*": "deny",
    "gh api * --raw-field *": "deny",
    "gh api * --raw-field=*": "deny",
    "gh api * --input *": "deny",
    "gh api * --input=*": "deny",
    "gh api * -F *": "deny",
    "gh api * -F=*": "deny",
    "gh api * -F*": "deny",
    "gh api * -f *": "deny",
    "gh api * -f=*": "deny",
    "gh api * -f*": "deny",
    "gh api * -i *": "deny",
    "gh api * -i*": "deny"
  },
  "paths": {
    "allow": [
      "/nix/store/**",
      "/dev/null"
    ],
    "deny": [
      "/Users/*/.ssh/**",
      "/Users/*/.aws/**",
      "/Users/*/.gnupg/**"
    ]
  },
  "jj": {
    "DENY": [
      {
        "externalShell": "git"
      }
    ],
    "READ": [
      "diff",
      "evolog",
      "file list",
      "file show",
      "file search",
      "file annotate",
      "git fetch",
      "help",
      "log",
      "operation log",
      "operation diff",
      "operation show",
      "root",
      "show",
      "status",
      "version",
      "workspace list",
      "evo",
      "cm",
      "ng",
      "plain",
      "cmng",
      "np",
      {
        "externalShell": "jd"
      },
      {
        "externalShell": "gd"
      },
      {
        "externalShell": "jsh"
      },
      {
        "externalShell": "jgf"
      },
      {
        "externalShell": "jbl"
      },
      {
        "externalShell": "jst"
      },
      {
        "externalShell": "gst"
      },
      {
        "externalShell": "jl"
      },
      {
        "externalShell": "jdd"
      }
    ],
    "WRITE": [
